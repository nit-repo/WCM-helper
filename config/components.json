{
  "version": 1,
  "notes": "AEM + Tridion component dictionary. `pageTypes` drives the commonly-expected-but-absent nudge; `requiredAssets` drives missing-asset detection. Trigger terms are matched case-insensitively on word boundaries.",

  "assets": {
    "dam_image": {
      "label": "DAM image reference",
      "question": "Which DAM asset should be used? Please give the /content/dam path or the assets.kone.com URL.",
      "detect": [{ "regex": "/content/dam|assets\\.kone\\.com|urn:aaid:aem|dam path|dam asset|\\.jpe?g|\\.png|\\.webp|\\.avif" }]
    },
    "alt_text": {
      "label": "Image alt text",
      "question": "What alt text should the image carry? It's mandatory for WCAG 2.1/2.2 AA.",
      "detect": [{ "regex": "alt ?text|alt attribute|alt=" }]
    },
    "video_url": {
      "label": "Video URL",
      "question": "What's the video URL to embed — YouTube, Vimeo, or an Adobe Media asset?",
      "detect": [{ "regex": "youtube|youtu\\.be|vimeo|video url|video link|adobe media" }]
    },
    "form_fields": {
      "label": "Form field list",
      "question": "Which fields does the form need, and where should submissions go?",
      "detect": [{ "regex": "field list|form fields|first name|last name|email field|submit to|recipient" }]
    },
    "link_target": {
      "label": "Link target",
      "question": "Where should this link or CTA point? Give the target page path so it can be set via Path Picker.",
      "detect": [{ "signal": "urlPresent" }, { "signal": "contentPathPresent" }, { "regex": "links? to|points? to|target page|destination" }]
    },
    "copy": {
      "label": "Final copy",
      "question": "Please supply the final approved copy for this component.",
      "detect": [{ "regex": "copy is|copy:|text is|text:|headline|reads:|should say|should read|wording|body copy" }]
    }
  },

  "recommendOrder": [
    "cta-button", "hero", "grid-block", "accordion", "form", "media-block",
    "related-stories", "teaser", "cmp-image", "carousel", "video-embed",
    "sidebar-cta", "title-header", "language-selector", "kone-container", "content-fragment"
  ],

  "pageTypes": {
    "homepage": ["homepage", "home page", "landing hub", "front page"],
    "pdp": ["product page", "product detail", "pdp", "elevator product", "escalator product", "product spec"],
    "campaign": ["campaign", "promo page", "promotion", "seasonal", "launch page", "campaign landing"],
    "article": ["article", "editorial", "story", "stories hub", "blog", "case study", "news page"],
    "category": ["category page", "listing page", "plp", "overview page", "hub page", "services page", "digital-services"],
    "contact": ["contact page", "contact us", "enquiry page", "get in touch", "reach us", "lead gen page"]
  },

  "components": [
    {
      "id": "kone-container",
      "name": "kone-container / Container",
      "platform": "AEM",
      "type": "Layout / Structural",
      "triggers": ["container", "section", "anchor", "anchor id", "layout", "wrapper"],
      "pageTypes": ["homepage", "pdp", "campaign", "article", "category", "contact"],
      "requiredAssets": [],
      "effortAuthor": "Very Low",
      "effortQA": "Low",
      "riskFlags": ["accented-anchor-id", "rte-anchor-rollout"],
      "note": "Anchor IDs must be plain ASCII. In-page anchors belong in the Container Anchor ID field, never in RTE HTML."
    },
    {
      "id": "exf",
      "name": "Experience Fragment (cmp-experiencefragment)",
      "platform": "AEM",
      "type": "Shared / Reusable",
      "triggers": ["exf", "experience fragment", "header", "footer", "navigation", "mega menu", "nav link", "drawer", "promo drawer"],
      "pageTypes": ["homepage", "pdp", "campaign", "article", "category", "contact"],
      "requiredAssets": [],
      "effortAuthor": "High",
      "effortQA": "High",
      "riskFlags": ["exf-child-publish", "async-rollout-collision", "untranslated-nav-labels"],
      "note": "Master EN → Region Master (AME/FPL) → Country Site. Publishing the folder does not publish children."
    },
    {
      "id": "title-header",
      "name": "Title Header XL / L",
      "platform": "AEM",
      "type": "Content",
      "triggers": ["title", "heading", "h1", "h2", "page title", "section heading", "title header"],
      "pageTypes": ["homepage", "pdp", "campaign", "article", "category", "contact"],
      "requiredAssets": ["copy"],
      "effortAuthor": "Very Low",
      "effortQA": "Low",
      "riskFlags": ["missing-h1", "h1-equals-page-title"],
      "note": "XL = H1, one per page, and its text must differ from the Page Properties Title."
    },
    {
      "id": "text-block",
      "name": "Text Block / AEM RTE",
      "platform": "AEM",
      "type": "Content",
      "triggers": ["body copy", "paragraph", "rte", "rich text", "inline link", "text block", "copy block"],
      "pageTypes": ["homepage", "pdp", "campaign", "article", "category", "contact"],
      "requiredAssets": ["copy"],
      "effortAuthor": "Low",
      "effortQA": "Medium",
      "riskFlags": ["rte-anchor-rollout", "author-url-leak"],
      "note": "Internal links inside RTE must be set via Path Picker; RTE-embedded anchors break on multi-region rollout."
    },
    {
      "id": "hero",
